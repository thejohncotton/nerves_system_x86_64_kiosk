CONFIG_MODULE_UNLOAD=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
# CONFIG_INET_DIAG is not set
# CONFIG_IPV6_SIT is not set
CONFIG_MPTCP=y
CONFIG_PCI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_BLK=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_SCSI_VIRTIO=y
CONFIG_SCSI_DH=y
CONFIG_SCSI_DH_HP_SW=y
CONFIG_ATA=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_INPUT_EVDEV=y
CONFIG_SERIO_RAW=y
CONFIG_LEGACY_PTY_COUNT=8
CONFIG_SERIAL_8250=y
# CONFIG_SERIAL_8250_DEPRECATED_OPTIONS is not set
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
# CONFIG_HW_RANDOM_VIA is not set
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_INTEL_POWERCLAMP=y
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_SOFT_WATCHDOG=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_DYNAMIC_MINORS=y
CONFIG_SND_SEQUENCER=y
CONFIG_SND_SOC=y
# --- Internal audio: Alder Lake-N HD Audio (legacy HDA mode — no SOF DSP
#     firmware in this image; snd_intel_dspcfg.dsp_driver=1 on the kernel
#     cmdline forces the legacy driver even if dsp_config would prefer SOF).
#     Realtek codec for the 3.5mm jack, HDMI codec for display audio.
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
# --- USB audio class (mics / interfaces): built-in like HDA so a device plugged
#     at boot enumerates with no module autoload dance. Cymatics + the platform
#     capture rely on external USB inputs (the Pi has one; the F9B mic was
#     invisible without this — "USB PnP Sound Device" on the bus, no ALSA card).
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
CONFIG_HIDRAW=y
CONFIG_HID_MULTITOUCH=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_TMPFS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
# CONFIG_NETWORK_FILESYSTEMS is not set
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_850=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_CRYPTO_CRC32C_INTEL=y
CONFIG_CRYPTO_DEV_VIRTIO=y

# ============================================================================
# Higole F9B Pro (Intel N95 / Alder Lake-N) hardware enablement.
# Added for the kiosk fork; each block maps to a fact in results/probe-report.txt.
# ============================================================================

# --- Intel iGPU (Alder Lake-N UHD [8086:46d2]) + MIPI-DSI panel -------------
# i915 includes the Intel DSI encoder; the 7" DSI panel is described by the
# firmware VBT, so no separate panel driver is needed. Needs DMC/GuC firmware
# (added via BR2_PACKAGE_LINUX_FIRMWARE_INTEL_I915 in nerves_defconfig).
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Console-level rotation (only affects the text console; the Wayland compositor
# handles the real kiosk rotation via an output transform — see grub.cfg).
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# --- Touch: Goodix GDIX1002 over Intel LPSS (DesignWare) I2C ----------------
# GPIOLIB and COMMON_CLK are required deps the minimal base config omits:
#   TOUCHSCREEN_GOODIX      depends on GPIOLIB
#   I2C_DESIGNWARE_PLATFORM depends on (ACPI && COMMON_CLK)   [x86 has ACPI=y]
# Without them, olddefconfig silently drops the touch driver + LPSS I2C bus.
CONFIG_GPIOLIB=y
CONFIG_COMMON_CLK=y
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y

# The F9B's touch controller enumerates in ACPI as GDIX1002 — a HID-over-I2C device,
# NOT the native goodix protocol, so TOUCHSCREEN_GOODIX doesn't bind it. HID-over-I2C
# on x86/ACPI needs I2C_HID_ACPI (pulls I2C_HID_CORE); the touch reports are then
# handled by HID_MULTITOUCH (already enabled) to create a multitouch input device.
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_I2C_HID_CORE=y

# The touch controller's interrupt is a GpioInt on the SoC GPIO. Without the Intel
# pinctrl/GPIO driver there is NO gpiochip, so the IRQ can't be resolved and the ACPI
# i2c client for GDIX1002 is deferred forever (never created -> no touch). The F9B's
# GPIO controllers enumerate as INTC1055/56/57 (Alder Lake-N). Enable Intel pinctrl +
# the Alder Lake (and Tiger Lake, which some ADL-N reuse) drivers. GDIX1002 then binds
# via the native TOUCHSCREEN_GOODIX driver.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_TIGERLAKE=y

# The touch's I2C controller is an Intel LPSS I2C in PCI mode (00:15.x, device
# 0x54e8/e9/eb) with NO driver — the base config lacks the intel-lpss MFD driver.
# intel-lpss-pci binds those PCI devices and instantiates the DesignWare I2C platform
# device that I2C_DESIGNWARE_PLATFORM drives, creating the i2c bus the touch lives on.
# Without this there's no LPSS i2c bus at all (only i915 GMBUS) -> GDIX1002 has no bus.
CONFIG_MFD_CORE=y
CONFIG_MFD_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y

# --- Ethernet: 2x Realtek RTL8125 2.5GbE [10ec:8125] (r8169 in 6.x) ---------
CONFIG_MDIO_DEVICE=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
CONFIG_R8169=y

# --- Internal boot disk: SATA SSD /dev/sda (AHCI). USB boot already works via
#     USB_STORAGE in the base config; AHCI is for flashing to the internal SSD.
CONFIG_SATA_AHCI=y

# --- WiFi: Realtek RTL8821CE [10ec:c821] (rtw88). Firmware comes from
#     BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88. The driver MUST be a module: built-in
#     it probes before the rootfs is mounted, the firmware load fails with -ENOENT,
#     and the device stays dead until a manual PCI rebind. As modules, eudev loads
#     it after boot and the firmware is right there.
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RTW88=m
CONFIG_RTW88_CORE=m
CONFIG_RTW88_PCI=m
CONFIG_RTW88_8821CE=m
