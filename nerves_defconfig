BR2_PACKAGE_NBTTY=y
BR2_PACKAGE_NERVES_CONFIG=y
BR2_PACKAGE_NERVES_CONFIG_ACCEPT_RNG_NOTICE=y

# ============================================================================
# Higole F9B Pro kiosk additions (fork). See README-kiosk.md.
# ============================================================================

# --- eudev: REQUIRED. weston, libinput, and cog's DRM platform all
#     `depend on BR2_PACKAGE_HAS_UDEV`. The base Nerves system creates /dev
#     statically, so without eudev those packages are silently dropped. This
#     switches to dynamic device creation (same as the kiosk_system_rpi5 system).
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# --- GPU firmware (i915 needs DMC/GuC blobs for Alder Lake-N or the GPU wedges;
#     rtw88 for WiFi; rtl_8169 covers the RTL8125 NIC firmware). NOTE: the correct
#     Buildroot option is _I915 (not _INTEL_I915) and _RTL_RTW88 (not _RTL_8821C) —
#     the old names silently dropped, leaving the GPU firmware-less and wedged. -
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
# --- Bluetooth firmware for the RTL8821CE BT radio (USB 0bda:c821, btusb+btrtl —
#     see the BT block in linux-6.12.defconfig). The rtl8821c blobs live in
#     linux-firmware's rtl_bt/ dir; the RTL_88XX_BT option's rtl_bt/rtl88*.bin glob
#     covers BOTH rtl8821c_fw.bin and rtl8821c_config.bin (btrtl needs both). Note
#     RTL_87XX_BT is only 8723/8761 and does NOT cover this chip. (BLUETOOTH_PLAN.md
#     Phase 4.)
#     NOTE: verified on-device that Buildroot does NOT reinstall linux-firmware on an
#     *incremental* rebuild when only this sub-option is added (the target /lib/firmware/
#     rtl_bt/ stayed empty and btrtl's request_firmware failed -ENOENT). This option is
#     still correct for a *clean* build; as belt-and-suspenders the two blobs are also
#     shipped via rootfs_overlay/lib/firmware/rtl_bt/ so the image always has them. To make
#     this option deliver on an incremental build, force `make linux-firmware-dirclean`.
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y

# --- WiFi userspace: VintageNetWiFi drives wpa_supplicant over its control
#     socket — without the package, wlp1s0 comes up but can never join or host
#     a network. Options mirror kiosk_system_rpi5 (minus WIRED/MESH).
#     wireless-regdb installs /lib/firmware/regulatory.db so cfg80211 gets real
#     channel limits instead of the world domain.
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y
BR2_PACKAGE_WPA_SUPPLICANT_HOTSPOT=y
BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y
BR2_PACKAGE_WPA_SUPPLICANT_WPS=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y

# --- Bluetooth userspace (BLUETOOTH_PLAN.md Phase 5). bluetoothd + bluetoothctl/btmgmt,
#     driven from Rust via `bluer` over D-Bus. bluez5_utils `select`s dbus, which also puts
#     libdbus-1 in the sysroot — REQUIRED for the app's `bluer` dependency to cross-compile
#     (its `dbus` crate finds libdbus-1 via pkg-config). Unlike the RPi5, the F9B image has no
#     other D-Bus consumer, so DBUS is a genuinely new package here. EXPERIMENTAL enables the
#     full BLE/GATT D-Bus API. State lives under /var/lib/bluetooth.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_EXPERIMENTAL=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y

# --- GPU userland: Mesa "iris" (Intel Gen12 / Alder Lake-N) with GLES/EGL/GBM.
#     wpewebkit/cog need HAS_LIBGLES + HAS_LIBEGL; cog-drm needs GBM w/ dma-buf.
#     The iris gallium driver `depends on BR2_PACKAGE_MESA3D_LLVM` — without LLVM,
#     iris drops, no gallium driver is selected, and OPENGL_EGL/ES/GBM (hence
#     wpewebkit) are silently omitted. (rpi5's V3D driver doesn't need LLVM; Intel
#     iris does — this is a real, longer build: host+target LLVM.)
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y

# --- Wayland kiosk: Weston compositor + Cog (WPE WebKit) browser --------------
# Mirrors the proven kiosk_system_rpi5 stack (verified present in Buildroot
# 2025.11.3). Hard deps (wayland, libinput, wpebackend-fdo, libdrm, dejavu,
# seatd) are auto-selected. Cog opens HOME_URI full-screen at boot; point it at
# the kiosk app (default: a local server on :4000, same convention as rpi5).
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WPEWEBKIT=y
BR2_PACKAGE_WPEWEBKIT_MULTIMEDIA=y
BR2_PACKAGE_COG=y
BR2_PACKAGE_COG_PROGRAMS_HOME_URI="http://localhost:4000/"
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL=y

# ============================================================================
# VHSynth kiosk-app stack (ported from kiosk_system_rpi5 `mpv-test`). The Rust
# app (vhsynth_app) needs: mpv (video engine), x264 + a specific GStreamer plugin
# set (WebRTC/RTP/H.264 streaming), ffmpeg-with-x264 (transcode), ALSA utils
# (MIDI + audio), and fonts for the Cog web UI. SQLite is bundled into the Rust
# binary (rusqlite). Skipped vs rpi5: V3D/mesa + rpi-firmware + DTC (hardware),
# fluid-soundfont (~140MB, unused), alsabat (pulls fftw), kmssrc (needs gst>=1.26).
# ============================================================================

# Audio + MIDI (Rust cpal/midir use libasound directly; utils for diagnostics)
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ACONNECT=y
BR2_PACKAGE_ALSA_UTILS_AMIDI=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_APLAYMIDI=y
BR2_PACKAGE_ALSA_UTILS_ARECORDMIDI=y
BR2_PACKAGE_ALSA_UTILS_ASEQDUMP=y
BR2_PACKAGE_ALSA_UTILS_ASEQNET=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# Video engine
BR2_PACKAGE_MPV=y

# H.264 encode: x264 lib + ffmpeg GPL/x264 + gst "ugly" x264 plugin
BR2_PACKAGE_X264=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_GPL=y
BR2_PACKAGE_GST1_PLUGINS_UGLY=y
BR2_PACKAGE_GST1_PLUGINS_UGLY_PLUGIN_X264=y

# GStreamer streaming/WebRTC: RTP payload/manager + webrtcbin (auto-selects
# libnice + dtls plugin + openssl) + SRTP + videotestsrc. matroskamux and
# gst1-libav (avdec/avenc_aac) are already present in the base image.
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTP=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTPMANAGER=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_WEBRTC=y
BR2_PACKAGE_LIBSRTP2=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOTESTSRC=y

# Fonts for the Cog kiosk UI (Liberation TTF; woff2 fails in Cog per VHSynth docs)
BR2_PACKAGE_LIBERATION=y

# Debug convenience: poke the mpv IPC socket over SSH
BR2_PACKAGE_SOCAT=y

# Cap parallel jobs to avoid OOM. WebCore's unified sources peak at ~2-3 GB per cc1plus,
# so j12 exceeds a 24 GB build VM and the kernel kills the compiler mid-link.
BR2_JLEVEL=6
