Subject: [PATCH] goodix: GOLE 2 Pro GT911 — report from the contact record when the status byte is empty

This GT911 firmware (1062, ACPI GDIX1001) never sets the buffer-ready bit or
a contact count in the 0x814E status byte, but the contact record behind it is
live on every interrupt. Fall back to it (non-zero size = one finger down) and
keep a rate-limited dump of the first two records to learn release/multi-touch.

--- a/drivers/input/touchscreen/goodix.c
+++ b/drivers/input/touchscreen/goodix.c
@@ -275,8 +275,12 @@
 
 		if (data[0] & GOODIX_BUFFER_STATUS_READY) {
 			touch_num = data[0] & 0x0f;
-			if (touch_num > ts->max_touch_num)
+			if (touch_num > ts->max_touch_num) {
+				dev_err_ratelimited(&ts->client->dev,
+					"goodix-dbg: touch_num %d > max %d (status 0x%02x)\n",
+					touch_num, ts->max_touch_num, data[0]);
 				return -EPROTO;
+			}
 
 			if (touch_num > 1) {
 				addr += header_contact_keycode_size;
@@ -304,6 +308,31 @@
 	 * The Goodix panel will send spurious interrupts after a
 	 * 'finger up' event, which will always cause a timeout.
 	 */
+	/*
+	 * Higole GOLE 2 Pro (GT911 fw 1062, ACPI GDIX1001): the status byte at
+	 * 0x814E never carries the buffer-ready bit or a contact count, yet the
+	 * contact record behind it is live — track id, x, y and size update on
+	 * every interrupt. Fall back to the first record: a non-zero size means
+	 * one finger down, zero means finger up. (Multi-touch: unknown, see dump.)
+	 */
+	if (ts->contact_size == GOODIX_CONTACT_SIZE) {
+		const u8 *rec = data + 1;
+		int size = get_unaligned_le16(&rec[5]);
+
+		/* second record, for the dump only (same read the >1 path does) */
+		if (goodix_i2c_read(ts->client, addr + header_contact_keycode_size,
+				    data + header_contact_keycode_size, ts->contact_size))
+			memset(data + header_contact_keycode_size, 0xee, ts->contact_size);
+		dev_err_ratelimited(&ts->client->dev,
+			"goodix-dbg: status %02x rec0 id=%u x=%u y=%u size=%d rec1 %02x %02x %02x %02x %02x %02x %02x %02x key %02x\n",
+			data[0], rec[0], get_unaligned_le16(&rec[1]),
+			get_unaligned_le16(&rec[3]), size,
+			data[9], data[10], data[11], data[12], data[13], data[14],
+			data[15], data[16], data[17]);
+		if (size)
+			return 1;
+		return 0;
+	}
 	return -ENOMSG;
 }
 
@@ -1237,6 +1266,10 @@
 	if (error)
 		return error;
 
+	dev_info(&ts->client->dev,
+		"goodix-dbg: irq_pin_access=%d trigger=%d max_touch=%d contact_size=%d x_max=%d y_max=%d irq=%d\n",
+		ts->irq_pin_access_method, ts->int_trigger_type, ts->max_touch_num,
+		ts->contact_size, ts->prop.max_x, ts->prop.max_y, ts->client->irq);
 	ts->irq_flags = goodix_irq_flags[ts->int_trigger_type] | IRQF_ONESHOT;
 	error = goodix_request_irq(ts);
 	if (error) {
